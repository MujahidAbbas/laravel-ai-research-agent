{
    "name": "shipfastlabs/toolkit-firecrawl",
    "version": "1.0.0",
    "description": "Firecrawl tools for the Laravel AI SDK - Scrape, Map, Search, and Crawl",
    "keywords": [
        "laravel",
        "ai",
        "tool",
        "firecrawl",
        "scrape",
        "crawl",
        "search",
        "map"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^0.7 || ^0.11"
    },
    "autoload": {
        "psr-4": {
            "Shipfastlabs\\Toolkit\\Firecrawl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shipfastlabs\\Toolkit\\Firecrawl\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
